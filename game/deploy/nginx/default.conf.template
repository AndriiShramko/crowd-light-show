# lightshow-game — статика Фазы A + WS-прокси Фазы B/C, за общим nginx-proxy (vhost game.flyreelstudio.eu).
# envsubst подставляет ТОЛЬКО ${GAME_ENABLED}; $uri/$http_upgrade и пр. остаются nginx'у (см. entrypoint nginx).
map $http_upgrade $conn_upgrade { default upgrade; '' close; }

upstream game_ws { server lightshow-game-ws:8081; }

server {
    listen 8080;
    server_name _;

    gzip on;
    gzip_types application/javascript text/css text/html application/json;
    gzip_min_length 1024;

    set $game_enabled "${GAME_ENABLED}";

    location = /healthz {
        default_type text/plain;
        return 200 "ok";
    }

    # Метрики/дебаг игрового сервера — за HMAC debug-токеном (проверяет сам Node); наружу только через токен.
    location = /metrics { proxy_pass http://game_ws; proxy_set_header Host $host; }
    location /debug/ { proxy_pass http://game_ws; proxy_set_header Host $host; }
    # Игровое API (анонимный /api/join, флаги /api/invite|inscription) → game-ws
    location /api/ { if ($game_enabled = "0") { return 503; } proxy_pass http://game_ws; proxy_set_header Host $host; }

    # WS игрового сервера (Фазы B/C): апгрейд + без буферизации + длинные таймауты.
    location /ws {
        if ($game_enabled = "0") { return 503; }
        proxy_pass http://game_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $conn_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Тяжёлые миры: immutable-кеш, range/206 нативно, канал клампится per-connection.
    location /static/worlds/ {
        if ($game_enabled = "0") { return 503; }
        alias /srv/worlds/;
        limit_rate 2m;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /vendor/ {
        if ($game_enabled = "0") { return 503; }
        root /srv/app;
        add_header Cache-Control "public, max-age=86400";
    }

    location / {
        if ($game_enabled = "0") { return 503; }
        root /srv/app;
        index index.html;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ =404;
    }
}
